# 仅供独立源码开发参考。根 Compose 使用 deploy/stack.ps1 init 生成自己的配置和秘密文件。
# 复制为仓库根目录的 .env 后，仅填本机隔离环境的实际值；勿提交密钥。
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PUBLIC_BASE_URL=
SECRET_KEY=
APP_ENV=production

# 外部连接默认关闭；只在取得真实授权并完成单独联调后重新评估。
ARK_API_KEY=
ARK_IMAGE_ENDPOINT=
ARK_VIDEO_ENDPOINT=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
DOUYIN_OAUTH_ENABLED=0
PUBLISH_LIVE=0
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_OAUTH_FRONTEND_ORIGIN=
DOUYIN_OAUTH_KEYS=
DOUYIN_OAUTH_ACTIVE_KEY_VERSION=
